{
  "description": "Nishan's Custom Bindings",
  "manipulators": [
    {
      "description": "Caps Lock toggle: Right ⌥ + Left ⌘ presses Caps Lock, since the Caps Lock key itself is ⌘ (held 100 ms so macOS takes it)",
      "from": {
        "key_code": "left_command",
        "modifiers": {
          "mandatory": ["right_option"],
          "optional": ["caps_lock"]
        }
      },
      "to": [
        {
          "hold_down_milliseconds": 100,
          "key_code": "caps_lock"
        }
      ],
      "type": "basic"
    },
    {
      "description": "⌘⌥ chord: Caps Lock (right ⌘) held, then Left ⌘, holds ⌘⌥, so Caps Lock + Left ⌘ + V is ⌘⌥V",
      "from": {
        "key_code": "left_command",
        "modifiers": { "mandatory": ["right_command"], "optional": ["caps_lock"] }
      },
      "to": [{ "key_code": "left_option", "modifiers": ["right_command"] }],
      "type": "basic"
    },
    {
      "description": "⌘⌥ chord, other order: Left ⌘ held, then Caps Lock (right ⌘), holds ⌘⌥",
      "from": {
        "key_code": "right_command",
        "modifiers": { "mandatory": ["left_command"], "optional": ["caps_lock"] }
      },
      "to": [{ "key_code": "right_option", "modifiers": ["left_command"] }],
      "type": "basic"
    },
    {
      "description": "Developer tools: ⌘⇧I sends ⌘⌥I, as Ctrl+Shift+I opens them on Linux and Windows",
      "from": {
        "key_code": "i",
        "modifiers": { "mandatory": ["command", "shift"] }
      },
      "to": [
        {
          "key_code": "i",
          "modifiers": ["command", "option"]
        }
      ],
      "type": "basic"
    },
    {
      "description": "Responsive mode: ⌘⇧M sends ⌘⌥M (Firefox's responsive design mode), as Ctrl+Shift+M on Linux and Windows",
      "from": {
        "key_code": "m",
        "modifiers": { "mandatory": ["command", "shift"] }
      },
      "to": [
        {
          "key_code": "m",
          "modifiers": ["command", "option"]
        }
      ],
      "type": "basic"
    },
    {
      "description": "Screenshot toolbar: F13 sends ⌘⇧5",
      "from": { "key_code": "f13" },
      "to": [
        {
          "key_code": "5",
          "modifiers": ["command", "shift"]
        }
      ],
      "type": "basic"
    },
    {
      "description": "No hiding: ⌘H sends ⌃⌥H instead of hiding the app",
      "from": {
        "key_code": "h",
        "modifiers": { "mandatory": ["command"] }
      },
      "to": [
        {
          "key_code": "h",
          "modifiers": ["control", "option"]
        }
      ],
      "type": "basic"
    }
  ]
}
